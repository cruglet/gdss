# @chunk main
# GDSS demo + stress-test theme.
# Split into named "chunks" (the tabs in the GDSS editor).

# @chunk Palette
@global var accent: "#8e00ff"
@global var accent_dark: "#5a00cc"
@global var bg: "#0d0d14"
@global var surface: "#16161f"
@global var surface_2: "#1f1f3a"
@global var text: "#ffffff"
@global var text_dim: "#9097ad"
@global var border: "#ffffff22"
@instance var card_color: "#16161f"

var radius: 10

# @chunk Buttons
Button {
	bg_color: linear_gradient($accent, $accent_dark, -45)
	border_color: $border
	border: 1 1 1 1
	corner_radius: $radius $radius $radius $radius
	font_color: $text
	font_size: 15
	padding: 12 12 6 6
	cursor: POINTING

	transition_time: 0.2
	transition_type: EASE_OUT
	transition_func: QUINT

	:hover {
		bg_color: linear_gradient($accent, $accent_dark, 45)
		expand: 2 2 2 2
	}

	:pressed {
		bg_color: $accent_dark
		expand: 0 0 0 0
	}

	:disabled {
		bg_color: $surface_2
		font_color: $text_dim
	}

	# Transparent with a colored border
	GhostButton {
		bg_color: rgba(0.0, 0.0, 0.0, 0.0)
		border_color: $accent
		border: 2 2 2 2
		font_color: $accent

		:hover {
			bg_color: alpha($accent, 0.15)
			font_color: $text
		}
	}

	# Pill shaped
	PillButton {
		corner_radius: 999 999 999 999
		padding: 16 16 8 8
	}
}

# @chunk Panels
Panel, PanelContainer {
	bg_color: $surface
	border_color: $border
	border: 1 1 1 1
	corner_radius: $radius $radius $radius $radius

	transition_time: 0.3
	transition_func: SINE

	# Elevated card with a gradient
	CardPanel {
		bg_color: linear_gradient($surface_2, $bg, 160)
		border_color: $border
	}
}

# @chunk Labels
Label {
	font_color: $text
	font_size: 12
	
	TitleLabel {
		font_size: 28
		font_color: $accent
	}

	SubtitleLabel {
		font_size: 16
		font_color: $text_dim
	}
}

# @chunk Inputs
LineEdit {
	bg_color: $bg
	border_color: $border
	border: 1 1 1 1
	corner_radius: $radius $radius $radius $radius
	font_color: $text
	font_size: 14
	padding: 8 8 8 8
	cursor: IBEAM
	selection_color: $accent

	transition_time: 0.15
	transition_type: EASE_OUT
	transition_func: SINE

	:focus {
		border_color: $accent
		border: 2 2 2 2
	}
}
