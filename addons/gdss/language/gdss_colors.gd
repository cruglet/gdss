	"WEB_GREEN", "WEB_MAROON", "WEB_PURPLE", "WHEAT", "WHITE", "WHITE_SMOKE", "YELLOW", "YELLOW_GREEN"
]
const ALIASES: Dictionary[String, Color] = {
	"TRANSPARENT_BLACK": Color(0, 0, 0, 0),
	"TRANSPARENT_WHITE": Color(1, 1, 1, 0),
}

static var _cache: Dictionary = {}


static func named(name: String, fallback: Color) -> Color:
	var cached: Variant = _cache.get(name)
	if cached != null:
		return cached if cached is Color else fallback
	var alias: Variant = ALIASES.get(name.to_upper())
	if alias is Color:
		_cache.set(name, alias)
		return alias
	var resolved: Color = Color.from_string(name, MISSING)
	if resolved != MISSING:
		_cache.set(name, resolved)
		return resolved
	_cache.set(name, false)
	return fallback


static func is_named(name: String) -> bool:
	return named(name, MISSING) != MISSING
